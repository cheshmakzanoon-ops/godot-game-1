; NEEDLEBEAT: DROP — Godot 4.6/4.7, portrait Android, Compatibility renderer.
config_version=5

[application]
config/name="NEEDLEBEAT: DROP"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Every shot risks the run. Every shot writes the song."
config/icon="res://art/icon.png"

[display]
window/size/viewport_width=480
window/size/viewport_height=854
window/size/window_width_override=480
window/size/window_height_override=854
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]
driver/enable_input=false
