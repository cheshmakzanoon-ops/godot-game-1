<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.needlebeat.wavverifier" android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
    <!-- A separate test-only UID. No storage/network permission or shared UID. -->
    <application android:label="NB WAV verifier" android:allowBackup="false"
        android:debuggable="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ReceiveActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
